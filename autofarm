    local message = string.lower(msgdata.Message)
    local plrChatted = Players:FindFirstChild(speaker)
    if not plrChatted or plrChatted == lp then return end

    -- Check proximity
    local theirChar = plrChatted.Character
    if not theirChar then return end
    local theirRoot = getRoot(theirChar)
    local myRoot = getRoot(lp.Character)
    if not theirRoot or not myRoot then return end
    local dist = (theirRoot.Position - myRoot.Position).Magnitude
    if dist > BOT_DENY_RANGE then return end

    task.wait(1.2 + math.random() * 0.6)

    if string.find(message, "bot") then
        -- Don't say "no im not" — just calmly roll with it
        handleBotAccusation()
