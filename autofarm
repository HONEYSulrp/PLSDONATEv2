end

-- ─── LEADERBOARD SCAN ────────────────────────────────────────────────────────
local spokenTo = {}  -- avoid re-tagging same person in same scan

local function scanLeaderboard()
    spokenTo = {}
    local targets = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr:FindFirstChild("leaderstats") then
            local raised = plr.leaderstats:FindFirstChild("Raised")
            if raised and raised.Value >= 500 then
                table.insert(targets, {plr = plr, raised = raised.Value})
            end
        end
    end
    -- sort descending
    table.sort(targets, function(a, b) return a.raised > b.raised end)
    -- tag top 2 max so we don't spam
    for i = 1, math.min(2, #targets) do
        local t = targets[i]
        if not spokenTo[t.plr.Name] then
            spokenTo[t.plr.Name] = true
            local template = LEADERBOARD_MESSAGES[math.random(1, #LEADERBOARD_MESSAGES)]
            local msg = string.gsub(template, "@NAME", "@" .. t.plr.DisplayName)
            task.wait(2 + math.random())
            typewriterChat(msg)
        end
    end
end

-- ─── PROXIMITY WALK ───────────────────────────────────────────────────────────
local inProximityWalk = false
local proximityTarget = nil

local function tryApproachPlayer(plr)
    if inProximityWalk then return end
    local char = lp.Character
    local myRoot = getRoot(char)
    if not myRoot then return end
    local theirChar = plr.Character
    if not theirChar then return end
    local theirRoot = getRoot(theirChar)
    if not theirRoot then return end

    inProximityWalk = true
    proximityTarget = plr

    -- Say we're coming
    task.spawn(function()
        local msg = "yo could u donate pls " .. plr.DisplayName .. " 🙏"
        typewriterChat(msg)
    end)

    -- Walk toward them, stopping 4 studs away
    local function getStopPos()
        if not theirRoot or not theirRoot.Parent then return nil end
        local dir = (theirRoot.Position - myRoot.Position).Unit
        return theirRoot.Position - dir * 4
    end

    local stopPos = getStopPos()
    if not stopPos then
        inProximityWalk = false
        return
    end

    walkTo(stopPos)

    -- Face them
    if theirRoot and theirRoot.Parent then
        faceToward(theirRoot.Position)
    end

    -- Wait a bit (they may move - if they stop we stop)
    local waited = 0
    while waited < WALK_BACK_DELAY do
        task.wait(0.5)
        waited += 0.5
        -- If they moved far, stop and return
        if theirRoot and theirRoot.Parent then
            local dist = (theirRoot.Position - myRoot.Position).Magnitude
            if dist > PROXIMITY_RANGE * 1.5 then
                break
            end
        else
            break
        end
    end

    -- Return to booth
    returnToBooth()
    inProximityWalk = false
    proximityTarget = nil
end

-- ─── CLAIM BOOTH + SET TEXT ──────────────────────────────────────────────────
local unclaimed = {}
local function findUnclaimed()
    for _, v in pairs(lp.PlayerGui.MapUIContainer.MapUI.BoothUI:GetChildren()) do
        if v:FindFirstChild("Details") and v.Details.Owner.Text == "unclaimed" then
            table.insert(unclaimed, tonumber(string.match(tostring(v), "%d+")))
        end
    end
end
pcall(findUnclaimed)

local function claimBooth()
    if #unclaimed == 0 then return false end
    local ok = pcall(function()
        require(game:GetService("ReplicatedStorage").Remotes).Event("ClaimBooth"):InvokeServer(unclaimed[1])
    end)
    return ok
end

local function setBoothText()
    pcall(function()
        require(game:GetService("ReplicatedStorage").Remotes).Event("SetBoothText"):FireServer(BOOTH_TEXT, "booth")
    end)
end

local function walkToBooth()
    local boothPos
    for _, v in ipairs(workspace.BoothInteractions:GetChildren()) do
        if v:GetAttribute("BoothSlot") == unclaimed[1] then
            boothPos = (v.CFrame * CFrame.new(0, 0, 3)).Position
            break
        end
    end
    if boothPos then
        boothPosition = boothPos
        walkTo(boothPos)
    end
end

