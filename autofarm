-- ─── HELPERS ─────────────────────────────────────────────────────────────────
local function getRoot(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function getHumanoid(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local boothPosition = nil

-- ─── PATHFIND ────────────────────────────────────────────────────────────────
local function walkTo(targetPos)
    local char = lp.Character
    if not char then return end
    local hum = getHumanoid(char)
    local root = getRoot(char)
    if not hum or not root then return end

    local path = PathfindingService:CreatePath({
        AgentHeight = 5, AgentRadius = 2, AgentCanJump = true,
    })
    local ok = pcall(function() path:ComputeAsync(root.Position, targetPos) end)
    if ok and path.Status == Enum.PathStatus.Success then
        for _, wp in ipairs(path:GetWaypoints()) do
            if wp.Action == Enum.PathWaypointAction.Jump then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            hum:MoveTo(wp.Position)
            local done = false
            local c = hum.MoveToFinished:Connect(function() done = true end)
            local t = 0
            while not done and t < 3 do task.wait(0.1); t += 0.1 end
            c:Disconnect()
        end
    else
        hum:MoveTo(targetPos)
        hum.MoveToFinished:Wait()
    end
end

local function faceToward(pos)
    local root = getRoot(lp.Character)
    if not root then return end
    root.CFrame = CFrame.lookAt(root.Position, Vector3.new(pos.X, root.Position.Y, pos.Z))
end

local function returnToBooth()
    if boothPosition then walkTo(boothPosition) end
end

-- ─── PROXIMITY WALK ───────────────────────────────────────────────────────────
local inProximityWalk = false

local function tryApproachPlayer(plr)
    if inProximityWalk then return end
    local myRoot = getRoot(lp.Character)
    local theirChar = plr.Character
    if not theirChar then return end
    local theirRoot = getRoot(theirChar)
    if not myRoot or not theirRoot then return end

    inProximityWalk = true
    task.spawn(function()
        typewriterChat("yo could u donate pls " .. plr.DisplayName .. " 🙏")
    end)

    local dir = (theirRoot.Position - myRoot.Position).Unit
    local stopPos = theirRoot.Position - dir * 4
    walkTo(stopPos)
    if theirRoot and theirRoot.Parent then faceToward(theirRoot.Position) end

    local waited = 0
    while waited < WALK_BACK_DELAY do
        task.wait(0.5); waited += 0.5
        if not theirRoot or not theirRoot.Parent then break end
        if (theirRoot.Position - myRoot.Position).Magnitude > PROXIMITY_RANGE * 1.5 then break end
    end

    returnToBooth()
    inProximityWalk = false
end

-- ─── LEADERBOARD SCAN ────────────────────────────────────────────────────────
local function scanLeaderboard()
    local targets = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr:FindFirstChild("leaderstats") then
            local raised = plr.leaderstats:FindFirstChild("Raised")
            if raised and raised.Value >= 500 then
                table.insert(targets, {plr = plr, raised = raised.Value})
            end
        end
    end
    table.sort(targets, function(a, b) return a.raised > b.raised end)
    for i = 1, math.min(2, #targets) do
        local t = targets[i]
        local msg = string.gsub(LEADERBOARD_MESSAGES[math.random(1,#LEADERBOARD_MESSAGES)], "@NAME", "@"..t.plr.DisplayName)
        task.wait(2 + math.random())
        typewriterChat(msg)
    end
end

