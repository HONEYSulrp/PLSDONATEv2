-- ─── HELPERS ─────────────────────────────────────────────────────────────────

local function getRoot(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function safeChat(msg)
    pcall(function()
        messageRequest:FireServer(msg, "All")
    end)
end

-- Typewriter: sends chars one at a time (simulates typing in chat)
-- Roblox chat doesn't support partial messages, so we send the full msg once
-- but add a small random delay to look human before sending
local function typewriterChat(msg)
    task.wait(0.5 + math.random() * 1.2) -- think before typing
    safeChat(msg)
end

local boothPosition = nil  -- set after claiming

-- ─── PATHFIND WALK ────────────────────────────────────────────────────────────
local function walkTo(targetPos)
    local char = lp.Character
    if not char then return end
    local hum = getHumanoid(char)
    if not hum then return end

    local path = PathfindingService:CreatePath({
        AgentHeight = 5,
        AgentRadius = 2,
        AgentCanJump = true,
    })

    local ok, err = pcall(function()
        path:ComputeAsync(getRoot(char).Position, targetPos)
    end)

    if ok and path.Status == Enum.PathStatus.Success then
        for _, wp in ipairs(path:GetWaypoints()) do
            if wp.Action == Enum.PathWaypointAction.Jump then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            hum:MoveTo(wp.Position)
            local arrived = false
            local conn
            conn = hum.MoveToFinished:Connect(function()
                arrived = true
                conn:Disconnect()
            end)
            local t = 0
            while not arrived and t < 3 do
                task.wait(0.1)
                t += 0.1
            end
            if not arrived then conn:Disconnect() end
        end
    else
        -- fallback direct move
        hum:MoveTo(targetPos)
        hum.MoveToFinished:Wait()
    end
end

local function faceToward(targetPos)
    local char = lp.Character
    if not char then return end
    local root = getRoot(char)
    if not root then return end
    root.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
end

local function returnToBooth()
    if boothPosition then
        walkTo(boothPosition)
    end
end

-- ─── BOT DETECTION HANDLER ───────────────────────────────────────────────────
local function handleBotAccusation()
